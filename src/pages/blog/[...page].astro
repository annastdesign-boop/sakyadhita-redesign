---
/**
 * /blog — paginated index of the Awakening Buddhist Women blog
 * (162 posts imported from awakeningbuddhistwomen.blogspot.com).
 * Newest post is featured on page 1; 15 posts per page.
 * Images stay on Blogger's CDN so they cost no Netlify bandwidth.
 */
import BaseLayout from '../../layouts/BaseLayout.astro'
import { CATEGORIES, categoriesFor, categoryLabel } from '../../lib/blogCategories'

export async function getStaticPaths({ paginate }: { paginate: any }) {
  const modules = import.meta.glob('../../content/blog/*.json', { eager: true })
  const posts = Object.values(modules)
    .map((m: any) => m.default)
    .sort((a: any, b: any) => b.published.localeCompare(a.published))
  return paginate(posts, { pageSize: 15 })
}

const { page } = Astro.props
const isFirst = page.currentPage === 1
const feature = isFirst ? page.data[0] : null
const rows = isFirst ? page.data.slice(1) : page.data

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })

// numbered pagination: sliding 7-page window, then … and the last page
const cur = page.currentPage
const last = page.lastPage
const winStart = Math.max(1, Math.min(cur - 3, last - 6))
const winEnd = Math.min(last, winStart + 6)
const nums = Array.from({ length: winEnd - winStart + 1 }, (_, i) => winStart + i)
const urlFor = (n: number) => (n === 1 ? '/blog/' : `/blog/${n}/`)

const title = isFirst
  ? 'Blog · Awakening Buddhist Women · Sakyadhita'
  : `Blog · Page ${page.currentPage} · Sakyadhita`
---

<BaseLayout
  title={title}
  description="Awakening Buddhist Women — stories, interviews, practice, and news from Sakyadhita's global community of Buddhist women."
  active=""
  ogImage={feature?.image ?? undefined}
>
  <div class="shell">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">›</span><span>Blog</span>
    </nav>
  </div>

  <section class="hero-compact">
    <div class="shell">
      <div class="eyebrow">SAKYADHITA BLOG</div>
      <h1 class="h-display">Awakening Buddhist Women</h1>
      <p class="lede">
        Stories, interviews, practice notes, and news from Buddhist women around the world.
      </p>
    </div>
  </section>

  <section class="blog-tools">
    <div class="shell">
      <form class="bt-bar" id="bt-form" role="search" onsubmit="return false">
        <label class="bt-search">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"/><path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <input id="bt-q" type="search" placeholder="Search posts…" aria-label="Search blog posts" autocomplete="off" />
        </label>
      </form>
      <div class="bt-cats" id="bt-cats" role="group" aria-label="Filter by category">
        <button type="button" class="opt is-on" data-cat="">All</button>
        {CATEGORIES.map((c) => <button type="button" class="opt" data-cat={c.id}>{c.label}</button>)}
      </div>
      <div class="bt-status" id="bt-status" hidden>
        <span id="bt-count"></span>
        <button type="button" class="bt-clear" id="bt-clear">Clear filters</button>
      </div>
      <div class="blog-list bt-results" id="bt-results" hidden></div>
    </div>
  </section>

  <div id="bt-default">
  {
    feature && (
      <section class="blog-feature-wrap">
        <div class="shell">
          <article class="blog-feature">
            <div class="bf-text">
              <h2><a href={`/blog/${feature.slug}/`}>{feature.title}</a></h2>
              <p class="bf-excerpt">{feature.excerpt}</p>
              <div class="post-meta">
                <span>{fmtDate(feature.published)}</span>
                <span class="dot">·</span>
                <span>{feature.minutes} min read</span>
              </div>
            </div>
            <a class="bf-pic" href={`/blog/${feature.slug}/`} aria-hidden="true" tabindex="-1">
              {feature.image && <img src={feature.image} alt="" loading="eager" />}
            </a>
          </article>
        </div>
      </section>
    )
  }

  <section class="blog-list-wrap">
    <div class="shell">
      <div class="blog-list">
        {
          rows.map((p: any) => (
            <article class="blog-row">
              <div class="br-text">
                <div class="br-label">{categoryLabel(categoriesFor(p)[0])}</div>
                <h3><a href={`/blog/${p.slug}/`}>{p.title}</a></h3>
                <p class="br-excerpt">{p.excerpt}</p>
                <div class="post-meta">
                  <span>{fmtDate(p.published)}</span>
                  <span class="dot">·</span>
                  <span>{p.minutes} min read</span>
                </div>
              </div>
              <a class="br-pic" href={`/blog/${p.slug}/`} aria-hidden="true" tabindex="-1">
                {p.thumb ? <img src={p.thumb} alt="" loading="lazy" /> : <span class="ph" />}
              </a>
            </article>
          ))
        }
      </div>

      <nav class="blog-pagination" aria-label="Blog pages">
        {page.url.prev ? (
          <a class="btn btn--ghost" href={page.url.prev}>← Newer</a>
        ) : (
          <span class="pg-spacer" />
        )}
        <div class="pg-nums">
          {winStart > 1 && (
            <>
              <a class="pg-n" href={urlFor(1)}>1</a>
              {winStart > 2 && <span class="pg-dots">…</span>}
            </>
          )}
          {nums.map((n) =>
            n === cur ? (
              <span class="pg-n is-cur" aria-current="page">{n}</span>
            ) : (
              <a class="pg-n" href={urlFor(n)}>{n}</a>
            )
          )}
          {winEnd < last && (
            <>
              {winEnd < last - 1 && <span class="pg-dots">…</span>}
              <a class="pg-n" href={urlFor(last)}>{last}</a>
            </>
          )}
        </div>
        {page.url.next ? (
          <a class="btn btn--ghost" href={page.url.next}>Older →</a>
        ) : (
          <span class="pg-spacer" />
        )}
      </nav>
    </div>
  </section>
  </div>

  <script type="application/json" id="bt-cat-json" set:html={JSON.stringify(Object.fromEntries(CATEGORIES.map((c) => [c.id, c.label])))} />
  <script>
    const CATS = JSON.parse(document.getElementById('bt-cat-json')?.textContent || '{}')
    const q = document.getElementById('bt-q') as HTMLInputElement
    const cats = document.getElementById('bt-cats')!
    const status = document.getElementById('bt-status')!
    const countEl = document.getElementById('bt-count')!
    const clearBtn = document.getElementById('bt-clear')!
    const results = document.getElementById('bt-results')!
    const dflt = document.getElementById('bt-default')!
    let index: any[] | null = null
    let loading: Promise<any[]> | null = null
    const state = { q: '', cat: '' }

    const params = new URLSearchParams(location.search)
    state.q = params.get('q') || ''
    state.cat = params.get('cat') || ''
    q.value = state.q

    const fmt = (iso: string) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
    const esc = (t: string) => t.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string)

    function load() {
      if (index) return Promise.resolve(index)
      if (!loading) loading = fetch('/blog/index.json').then((r) => r.json()).then((d) => (index = d))
      return loading
    }
    function active() { return !!(state.q.trim() || state.cat) }
    function paintCats() {
      cats.querySelectorAll('.opt').forEach((b) => b.classList.toggle('is-on', (b as HTMLElement).dataset.cat === state.cat))
    }
    function syncUrl() {
      const p = new URLSearchParams()
      if (state.q.trim()) p.set('q', state.q.trim())
      if (state.cat) p.set('cat', state.cat)
      const qs = p.toString()
      history.replaceState(null, '', (active() ? '/blog/' : location.pathname) + (qs ? '?' + qs : ''))
    }
    function row(p: any) {
      const thumb = p.thumb ? `<img src="${esc(p.thumb)}" alt="" loading="lazy" />` : '<span class="ph"></span>'
      return `<article class="blog-row">
        <div class="br-text">
          <div class="br-label">${esc(CATS[p.cats[0]] || '')}</div>
          <h3><a href="/blog/${esc(p.slug)}/">${esc(p.title)}</a></h3>
          <p class="br-excerpt">${esc(p.excerpt)}</p>
          <div class="post-meta"><span>${fmt(p.date)}</span><span class="dot">·</span><span>${p.minutes} min read</span></div>
        </div>
        <a class="br-pic" href="/blog/${esc(p.slug)}/" aria-hidden="true" tabindex="-1">${thumb}</a>
      </article>`
    }
    async function render() {
      paintCats(); syncUrl()
      if (!active()) { results.hidden = true; results.innerHTML = ''; dflt.hidden = false; status.hidden = true; return }
      const all = await load()
      const needle = state.q.trim().toLowerCase()
      const list = all.filter((p) => (!state.cat || p.cats.includes(state.cat)) && (!needle || (p.title + ' ' + p.excerpt).toLowerCase().includes(needle)))
      results.innerHTML = list.length ? list.map(row).join('') : '<p class="bt-empty">No posts match. Try another word or category.</p>'
      countEl.textContent = `${list.length} ${list.length === 1 ? 'post' : 'posts'}`
      results.hidden = false; dflt.hidden = true; status.hidden = false
    }
    let t: any
    q.addEventListener('input', () => { state.q = q.value; clearTimeout(t); t = setTimeout(render, 150) })
    cats.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('.opt') as HTMLElement | null
      if (!b) return
      state.cat = b.dataset.cat || ''
      render()
    })
    clearBtn.addEventListener('click', () => { state.q = ''; state.cat = ''; q.value = ''; render() })
    if (active()) render()
  </script>

  <style is:global>
    /* Search / sort / category bar */
    .blog-tools { padding: 0 0 10px; }
    .bt-bar { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
    .bt-search {
      flex: 1 1 260px; display: flex; align-items: center; gap: 10px;
      border: 1px solid var(--border); background: #fff; border-radius: 10px;
      padding: 0 14px; color: var(--ink-subtle);
      transition: border-color .15s, box-shadow .15s;
    }
    .bt-search:focus-within { border-color: var(--purple); box-shadow: 0 0 0 4px rgba(119,59,250,.12); }
    .bt-search svg { width: 18px; height: 18px; flex: none; }
    .bt-search input {
      flex: 1; min-width: 0; border: 0; outline: 0; background: transparent;
      padding: 12px 0; font: inherit; font-size: 14.5px; color: var(--ink);
    }
    .bt-cats { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
    .bt-cats .opt {
      font-family: var(--font-ui); font-size: 12.5px; font-weight: 600; letter-spacing: 0.02em;
      color: var(--ink-2); padding: 7px 14px; border-radius: var(--r-pill);
      background: transparent; border: 1px solid var(--border); cursor: pointer;
      transition: background .15s, color .15s, border-color .15s;
    }
    .bt-cats .opt:hover { border-color: var(--purple); color: var(--purple); }
    .bt-cats .opt.is-on { background: var(--ink); color: #fff; border-color: var(--ink); }
    .bt-status {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      margin-top: 18px; padding-bottom: 10px; border-bottom: 1px solid var(--border-soft);
      font-family: var(--font-num); font-weight: 600; font-size: 12px;
      letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-subtle);
    }
    .bt-clear { border: 0; background: none; font: inherit; color: var(--purple); cursor: pointer; letter-spacing: inherit; text-transform: inherit; }
    .bt-clear:hover { text-decoration: underline; }
    .bt-empty { padding: 32px 0; color: var(--ink-2); }
    .bt-results { padding-bottom: 40px; }

    /* Feature — headline left, large image right (kept on Blogger CDN) */
    .blog-feature-wrap { padding: 8px 0 26px; }
    .blog-feature {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 48px;
      align-items: center;
      padding-bottom: 34px;
      border-bottom: 1px solid var(--border-soft);
    }
    .blog-feature .bf-text h2 {
      font-family: var(--font-title);
      font-weight: 700;
      font-size: clamp(23px, 2.4vw, 31px);
      line-height: 1.08;
      letter-spacing: -0.01em;
    }
    .blog-feature .bf-text h2 a { color: var(--ink); text-decoration: none; }
    .blog-feature .bf-text h2 a:hover { color: var(--purple); }
    .bf-excerpt { margin-top: 14px; font-size: 16px; line-height: 1.6; color: var(--ink-body); }
    .bf-pic { display: block; border-radius: var(--r-lg); overflow: hidden; background: var(--bg-subtle); }
    .bf-pic img { display: block; width: 100%; aspect-ratio: 16/10; object-fit: cover; }

    .post-meta {
      margin-top: 14px;
      font-family: var(--font-num);
      font-weight: 600; font-size: 11.5px;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--ink-subtle);
      display: flex; gap: 8px; align-items: baseline;
    }
    .post-meta .dot { color: var(--border); }

    /* Rows — text left, thumbnail right, hairline dividers */
    .blog-list-wrap { padding: 6px 0 70px; }
    .blog-list { display: flex; flex-direction: column; }
    .blog-row {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 240px;
      gap: 36px;
      align-items: start;
      padding: 28px 0;
      border-bottom: 1px solid var(--border-soft);
    }
    .br-label {
      font-size: 11px; font-weight: 700; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--purple);
      margin-bottom: 8px;
    }
    .blog-row h3 {
      font-family: var(--font-title);
      font-weight: 700; font-size: 23px; line-height: 1.15;
      letter-spacing: -0.005em;
    }
    .blog-row h3 a { color: var(--ink); text-decoration: none; }
    .blog-row h3 a:hover { color: var(--purple); }
    .br-excerpt { margin-top: 10px; font-size: 14.5px; line-height: 1.6; color: var(--ink-body); max-width: 62ch; }
    .br-pic {
      display: block; border-radius: var(--r-md); overflow: hidden;
      background: var(--bg-subtle);
    }
    .br-pic img, .br-pic .ph { display: block; width: 100%; aspect-ratio: 3/2; object-fit: cover; }
    .br-pic .ph { background: linear-gradient(135deg, var(--lavender), var(--coral-2)); }

    .blog-pagination {
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; margin-top: 36px;
    }
    .pg-nums { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; justify-content: center; }
    .pg-n {
      min-width: 36px; height: 36px;
      display: grid; place-items: center;
      padding: 0 6px;
      border: 1px solid var(--border);
      border-radius: 10px;
      background: #fff;
      font-family: var(--font-num); font-weight: 600; font-size: 13.5px;
      color: var(--ink); text-decoration: none;
      transition: border-color .12s, color .12s;
    }
    a.pg-n:hover { border-color: var(--purple); color: var(--purple); }
    .pg-n.is-cur { background: var(--ink); border-color: var(--ink); color: #fff; }
    .pg-dots { color: var(--ink-subtle); padding: 0 2px; }
    .pg-spacer { width: 1px; }

    /* Desktop: 300px side margins up to a 1440px screen; beyond that the
       container stays at its 1440px width (840px) and only the background
       stretches. */
    @media (min-width: 1200px) {
      .hero-compact .shell,
      .blog-tools .shell,
      .blog-feature-wrap .shell,
      .blog-list-wrap .shell {
        width: calc(100% - 600px);
        max-width: 840px;
        padding: 0;
        margin: 0 auto;
      }
    }

    @media (max-width: 860px) {
      .blog-feature { grid-template-columns: 1fr; gap: 22px; }
      .blog-feature .bf-text { order: 2; }
      .bf-pic { order: 1; }
      .blog-row { grid-template-columns: 1fr; gap: 14px; }
      .br-pic { order: -1; max-width: 480px; }
    }
  </style>
</BaseLayout>
