---
/**
 * /blog/[slug] — one full blog post, imported from
 * awakeningbuddhistwomen.blogspot.com. The original HTML is kept;
 * images stay on Blogger's CDN (no Netlify bandwidth).
 */
import BaseLayout from '../../layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const modules = import.meta.glob('../../content/blog/*.json', { eager: true })
  const posts = Object.values(modules)
    .map((m: any) => m.default)
    .sort((a: any, b: any) => b.published.localeCompare(a.published))
  return posts.map((post: any, i: number) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }))
}

const { post, newer, older } = Astro.props

import { parse } from 'node-html-parser'

/**
 * Render-time layout pass over imported post HTML (runs at build).
 * Portrait/small images that float next to text become proper
 * two-column blocks (.media-cols): flexible text column + fixed-width
 * image column, instead of CSS floats. Landscape floats, full-width
 * images, and 2-up rows are left untouched. Inline width/height/align
 * attributes from Blogger are stripped here (and neutralized in CSS).
 */
/** Old-site URLs that appear in imported posts → pages on this site. */
function rewriteOldSiteUrl(href: string): string {
  const site = /^https?:\/\/(?:www\.)?sakyadhita\.org/i
  if (!site.test(href)) return href
  const path = href.replace(site, '')
  let m = path.match(/^\/conferences\/(\d+)(?:st|nd|rd|th)-si-con(?:\.html|\/.*)?$/i)
  if (m) return `/conferences/${m[1]}/`
  if (/^\/(?:resources\/|home\/)?newsletters\.html$/i.test(path)) return '/newsletters/'
  if (/^\/resources\/publications\.html$/i.test(path)) return '/publications/'
  if (path === '' || path === '/') return '/'
  return href
}

function layoutPost(html: string): string {
  const root = parse(html)

  // links to the old sakyadhita.org pages now point at our own pages
  for (const a of root.querySelectorAll('a[href]')) {
    const href = a.getAttribute('href') || ''
    const next = rewriteOldSiteUrl(href)
    if (next !== href) {
      a.setAttribute('href', next)
      a.removeAttribute('target') // internal link: same tab
      a.removeAttribute('rel')
    }
  }

  // Imported inline colors/backgrounds fight the design system. Strip them;
  // text that was deliberately coloured (orange/teal/green titles) becomes
  // brand purple, neutral greys/blacks and link-blues simply inherit.
  const NEUTRAL = /^(black|white|gray|grey|transparent|inherit|#0{3,6}|#f{3,6}|#[0-9a-f]{6})$/i
  // Blogger sizes that were really sub-headings (large / ≥19px / ≥14pt)
  const isLarge = (v: string) => {
    v = v.trim().toLowerCase()
    if (/^(large|x-large|xx-large|larger)$/.test(v)) return true
    const px = v.match(/^([\d.]+)px$/); if (px) return parseFloat(px[1]) >= 19
    const pt = v.match(/^([\d.]+)pt$/); if (pt) return parseFloat(pt[1]) >= 14
    return false
  }
  const isNeutral = (c: string) => {
    c = c.trim().toLowerCase()
    if (/^(black|white|gray|grey|transparent|inherit|blue|navy|red)$/.test(c)) return true
    const m = c.match(/^#([0-9a-f]{6})$/)
    if (m) {
      const r = parseInt(m[1].slice(0, 2), 16), g = parseInt(m[1].slice(2, 4), 16), b = parseInt(m[1].slice(4, 6), 16)
      const spread = Math.max(r, g, b) - Math.min(r, g, b)
      if (spread < 24) return true                 // grey/black/white
      if (b > r + 40 && b > g + 20) return true    // link blues
    }
    return /^rgba?\(/.test(c)
  }
  for (const el of root.querySelectorAll('[style]')) {
    const decls = (el.getAttribute('style') || '').split(';').map((d) => d.trim()).filter(Boolean)
    let accent = false
    let large = false
    const kept = decls.filter((d) => {
      const [prop, ...rest] = d.split(':')
      const name = prop.trim().toLowerCase(), val = rest.join(':').trim()
      if (name === 'color') { if (!isNeutral(val)) accent = true; return false }
      if (name === 'background' || name === 'background-color') return false
      // typography comes from the design system, not from Blogger
      if (name === 'font-size') { if (isLarge(val)) large = true; return false }
      if (name === 'font-family' || name === 'line-height' || name === 'font' || name === 'letter-spacing') return false
      if (name.startsWith('mso-')) return false // Word paste junk
      return true
    })
    if (kept.length) el.setAttribute('style', kept.join('; '))
    else el.removeAttribute('style')
    if (accent) el.classList.add('hl')
    if (large) el.classList.add('lg')
  }
  for (const f of root.querySelectorAll('font')) {
    const color = f.getAttribute('color')
    if (color && !isNeutral(color)) f.classList.add('hl')
    const size = parseInt(f.getAttribute('size') || '', 10)
    if (size >= 4) f.classList.add('lg')
    f.removeAttribute('color'); f.removeAttribute('size'); f.removeAttribute('face')
  }

  // strip legacy inline presentation attributes
  for (const el of root.querySelectorAll('[width],[height],[align],[border]')) {
    el.removeAttribute('width')
    el.removeAttribute('height')
    el.removeAttribute('align')
    el.removeAttribute('border')
  }

  const isBr = (n: any) => n.nodeType === 1 && n.rawTagName?.toLowerCase() === 'br'
  const isEmptyText = (n: any) => n.nodeType === 3 && !n.text.trim()

  for (const fig of root.querySelectorAll('figure')) {
    const cls = fig.getAttribute('class') || ''
    const floated = /\bfl\b|\bfr\b/.test(cls)
    if (!floated) continue
    // landscape images are too wide to inset in a ~72ch column (the text
    // beside them collapses to a sliver) — run them full width instead
    if (cls.includes('w-land')) {
      fig.setAttribute('class', 'pimg full')
      continue
    }

    // collect the text run that follows, up to the next figure/heading/row
    // (walk the parent's childNodes by index — text nodes have no nextSibling)
    const siblings: any[] = fig.parentNode ? fig.parentNode.childNodes : []
    const start = siblings.indexOf(fig) + 1
    const run: any[] = []
    let textLen = 0
    for (let i = start; i > 0 && i < siblings.length; i++) {
      const n: any = siblings[i]
      if (n.nodeType === 1) {
        const t = n.rawTagName?.toLowerCase() || ''
        const ncls = n.getAttribute?.('class') || ''
        if (t === 'figure' || /^h[1-6]$/.test(t) || ncls.includes('pimg-row') || ncls.includes('media-cols')) break
        if (n.querySelector && n.querySelector('figure')) break // never swallow another image's container
      }
      run.push(n)
      textLen += (n.text || '').trim().length
    }
    while (run.length && (isBr(run[0]) || isEmptyText(run[0]))) run.shift()

    if (textLen >= 220) {
      // magazine runaround: fixed-width 4:5 portrait floats beside the
      // text, which wraps and then returns to full measure below it
      const side = /\bfr\b/.test(cls) ? 'fr' : 'fl'
      const width = cls.includes('w-port') ? 'w-port' : cls.includes('w-sq') ? 'w-sq' : 'w-small'
      fig.setAttribute('class', `pimg mag ${side} ${width}`)
    } else {
      // not enough text to sit beside — stack it, centered
      const width = cls.includes('w-port') ? 'w-port' : 'w-small'
      fig.setAttribute('class', `pimg center ${width}`)
    }
  }
  // final sweep: any upright float that survived (e.g. cloned inside a
  // text column) stacks centered instead of floating
  for (const fig of root.querySelectorAll('figure')) {
    const cls = fig.getAttribute('class') || ''
    if (!cls.includes('mag') && (/\bfl\b|\bfr\b/.test(cls)) && /w-port|w-small|w-sq/.test(cls)) {
      fig.setAttribute('class', `pimg center ${cls.includes('w-port') ? 'w-port' : 'w-small'}`)
    }
  }
  return root.toString()
}

const bodyHtml = layoutPost(post.html)

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })

const ld = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.title,
  datePublished: post.published,
  dateModified: post.updated || post.published,
  image: post.image ? [post.image] : undefined,
  author: { '@type': 'Organization', name: 'Sakyadhita International Association of Buddhist Women' },
  publisher: { '@type': 'Organization', name: 'Sakyadhita International Association of Buddhist Women', url: 'https://sakyadhita.org' },
  mainEntityOfPage: `https://sakyadhita.org/blog/${post.slug}/`,
})
---

<BaseLayout
  title={`${post.title} · Sakyadhita Blog`}
  description={post.excerpt}
  active=""
  ogImage={post.image ?? undefined}
>
  <script type="application/ld+json" set:html={ld} />

  <div class="shell">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">›</span><a href="/blog/">Blog</a><span class="sep">›</span><span>{post.title}</span>
    </nav>
  </div>

  <article class="post">
    <div class="shell shell--narrow post-topback">
      <a class="back-plain" href="/blog/">← Back to all</a>
    </div>
    <header class="post-head">
      <div class="shell shell--narrow">
        {post.labels?.length > 0 && (
          <div class="post-labels">
            {post.labels.slice(0, 4).map((l: string) => <span class="chip">{l}</span>)}
          </div>
        )}
        <h1>{post.title}</h1>
        <div class="post-meta">
          <span>{fmtDate(post.published)}</span>
          <span class="dot">·</span>
          <span>{post.minutes} min read</span>
          <span class="dot">·</span>
          <span>Sakyadhita Blog</span>
        </div>
      </div>
    </header>

    <div class="shell shell--narrow">
      <div class="post-body" set:html={bodyHtml} />
    </div>

    <footer class="post-foot">
      <div class="shell shell--narrow">
        <nav class="post-nav" aria-label="More posts">
          {newer ? (
            <a class="pn pn--prev" href={`/blog/${newer.slug}/`}>
              <span class="pn-k">← Newer</span>
              <span class="pn-t">{newer.title}</span>
            </a>
          ) : (
            <span />
          )}
          {older ? (
            <a class="pn pn--next" href={`/blog/${older.slug}/`}>
              <span class="pn-k">Older →</span>
              <span class="pn-t">{older.title}</span>
            </a>
          ) : (
            <span />
          )}
        </nav>
        <div class="post-back">
          <a class="btn btn--ghost" href="/blog/">← All blog posts</a>
        </div>
      </div>
    </footer>
  </article>

  <style is:global>
    .post-head { padding: 18px 0 8px; text-align: left; }
    .post-labels { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
    .post-labels .chip {
      font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--purple);
      padding: 4px 10px; background: var(--lavender);
      border-radius: var(--r-pill, 999px);
    }
    .post-head h1 {
      font-family: var(--font-title);
      font-weight: 700;
      font-size: clamp(30px, 4vw, 46px);
      line-height: 1.08; letter-spacing: -0.01em;
      color: var(--ink);
      max-width: 26ch;
    }
    .post-head .post-meta {
      margin-top: 16px;
      font-family: var(--font-num);
      font-weight: 600; font-size: 11.5px;
      letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--ink-subtle);
      display: flex; gap: 8px; align-items: baseline; flex-wrap: wrap;
    }
    .post-head .post-meta .dot { color: var(--border); }

    /* Imported Blogger HTML — normalize inside our design system */
    .post-body {
      padding: 26px 0 8px;
      font-size: 16.5px; line-height: 1.7; color: var(--ink-body);
      overflow-wrap: break-word;
      /* readable measure in the wide layout (~72 characters) */
      max-width: 72ch;
    }
    /* Neutralize inline presentation left in imported Blogger markup */
    .post-body img { max-width: 100% !important; height: auto !important; float: none; }
    .post-body [align='left'], .post-body [align='right'] { float: none !important; }
    .post-body [style*='float'] { float: none !important; }
    .post-body p { margin: 0 0 1em; }
    .post-body a { color: var(--purple); }
    .post-body .hl { color: var(--purple); }
    .post-body .lg {
      font-family: var(--font-title); font-weight: 700;
      font-size: 20px; line-height: 1.3; color: var(--ink);
    }
    .post-body a:hover { text-decoration: underline; }
    .post-body img {
      max-width: 100%; height: auto;
      border-radius: var(--r-md);
      display: block;
    }
    .back-plain {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 10px 0;
      font-weight: 600; font-size: 14px;
      color: var(--purple); text-decoration: none;
    }
    .back-plain:hover { text-decoration: underline; }

    /* ── Book-style image system ────────────────────────────────
       .full   — first landscape image, full column width
       .fl/.fr — floated left/right, text wraps around
       .pimg-row — two landscape photos side by side
       Captions live inside the figure, so they wrap with it. */
    .post-body figure.pimg { margin: 6px 0 18px; }
    .post-body figure.pimg img { width: 100%; margin: 0; }
    .post-body figure.pimg figcaption {
      font-size: 12.5px; line-height: 1.5;
      color: var(--ink-2);
      padding-top: 8px;
      text-align: left;
    }
    .pimg.full { clear: both; margin: 26px 0; }
    /* clear:both — a new floated image always starts below the previous
       one, so two floats can never squeeze the text between them */
    .pimg.fl { float: left;  clear: both; margin: 12px 34px 20px 0; }
    .pimg.fr { float: right; clear: both; margin: 12px 0 20px 34px; }
    .pimg.center { clear: both; margin: 24px auto; }
    /* Consistent crops regardless of source size: portraits 4:5,
       square and small images 1:1 */
    .pimg.w-port img, .pimg.w-small img, .pimg.w-sq img {
      object-fit: cover;
      object-position: top center;
    }
    .pimg.w-port img { aspect-ratio: 4 / 5; }
    .pimg.w-sq img, .pimg.w-small img { aspect-ratio: 1 / 1; }

    /* ── Magazine runaround: fixed-width portrait floats in the text ── */
    .pimg.mag { width: 240px; }
    .pimg.mag.w-small { width: 200px; }
    .pimg.mag.fl { float: left;  clear: both; margin: 6px 34px 16px 0; }
    .pimg.mag.fr { float: right; clear: both; margin: 6px 0 16px 34px; }
    .pimg.mag figcaption { padding-top: 8px; }
    .pimg.center.w-port  { width: min(70%, 320px); }
    .pimg.center.w-small { width: min(70%, 340px); }
    /* Lists, tables, quotes create their own box next to a float —
       they keep the gap instead of sliding underneath the image. */
    .post-body ul, .post-body ol,
    .post-body table, .post-body blockquote { overflow: hidden; }
    .pimg.w-port  { width: min(44%, 270px); }
    .pimg.w-land  { width: min(48%, 420px); }
    .pimg.w-small { width: min(44%, 300px); }
    .pimg.w-sq    { width: min(44%, 310px); }
    .pimg-row {
      clear: both;
      display: grid; grid-template-columns: 1fr 1fr;
      gap: 16px; margin: 24px 0;
      align-items: start;
    }
    .pimg-row .pimg { margin: 0; }
    .pimg-row .pimg img { width: 100%; }
    .pimg-row .pimg.w-port img { object-position: center; }
    .pimg-row figcaption { padding-top: 8px; }
    .post-body::after { content: ""; display: block; clear: both; }
    @media (max-width: 700px) {
      .pimg.fl, .pimg.fr {
        float: none;
        width: 100%; max-width: 420px;
        margin: 16px auto;
      }
      .pimg-row { grid-template-columns: 1fr; }
      .pimg.mag.fl, .pimg.mag.fr {
        float: none;
        width: 100%; max-width: 320px;
        margin: 16px auto;
      }
    }
    /* Videos: full column width, 16:9. Inline width/height attributes
       from Blogger are stripped at render, so size comes from here. */
    .post-body iframe {
      display: block;
      clear: both;
      width: 100%;
      aspect-ratio: 16 / 9;
      height: auto;
      border: 0;
      border-radius: var(--r-md);
      margin: 22px 0;
    }
    /* legacy <center> wrappers shouldn't constrain the embed */
    .post-body center { display: block; }
    .post-body table { max-width: 100%; }
    .post-body h1, .post-body h2, .post-body h3, .post-body h4 {
      font-family: var(--font-title); color: var(--ink);
      line-height: 1.2; margin: 1.4em 0 0.5em;
    }
    .post-body blockquote {
      margin: 1.2em 0; padding: 4px 0 4px 18px;
      border-left: 3px solid var(--lavender-2, var(--purple));
      color: var(--ink-2);
    }

    .post-foot { padding: 26px 0 70px; }
    .post-nav {
      display: grid; grid-template-columns: 1fr 1fr; gap: 18px;
      border-top: 1px solid var(--border-soft);
      padding-top: 24px;
    }
    .pn { text-decoration: none; display: flex; flex-direction: column; gap: 6px; }
    .pn--next { text-align: right; }
    .pn-k {
      font-family: var(--font-num); font-weight: 600; font-size: 11px;
      letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-subtle);
    }
    .pn-t {
      font-family: var(--font-title); font-weight: 700; font-size: 16px;
      color: var(--ink); line-height: 1.25;
    }
    .pn:hover .pn-t { color: var(--purple); }
    .post-back { margin-top: 30px; }

    .post-topback { padding-top: 14px; }

    /* Desktop: 300px side margins up to a 1440px screen; wider screens keep
       the 840px container centered and stretch only the background. */
    @media (min-width: 1200px) {
      .post .shell--narrow {
        width: calc(100% - 600px);
        max-width: 840px;
        padding: 0;
        margin: 0 auto;
      }
    }

    @media (max-width: 640px) {
      .post-nav { grid-template-columns: 1fr; }
      .pn--next { text-align: left; }
    }
  </style>
</BaseLayout>
